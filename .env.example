# Copie ce fichier en .env (jamais commité). Sans .env, tout tourne en mode mock.

# --- Ports -------------------------------------------------------------------
# UI web (Next.js)
PORT=3000
# Moteur (FastAPI), joint par l'UI via le proxy /api/engine
ENGINE_PORT=8765

# --- LLM texte -----------------------------------------------------------------
# deepseek | mock   (ollama et claude : prévus, pas encore disponibles)
# Vide ou absent : mock.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Optionnels : surchargent presets/providers.yaml
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- Contrôle qualité visuel -------------------------------------------------
# mock   (deepseek et ollama : prévus au jalon 3)
VISION_PROVIDER=mock

# --- ComfyUI ---------------------------------------------------------------------
# http (vrai ComfyUI local) | mock (images factices)
COMFYUI_PROVIDER=http
COMFYUI_URL=http://127.0.0.1:8188

# --- Stockage ------------------------------------------------------------------
# MANGAKA_DATA_DIR=./data
# MAX_UPLOAD_MB=20
