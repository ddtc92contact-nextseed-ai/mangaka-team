# Copie ce fichier en .env (jamais commité). Sans .env, tout tourne en mode mock.

# --- Ports -------------------------------------------------------------------
# UI web (Next.js)
PORT=3000
# Moteur (FastAPI), joint par l'UI via le proxy /api/engine
ENGINE_PORT=8765

# --- LLM texte -----------------------------------------------------------------
# deepseek | mock   (ollama et claude : prévus, pas encore disponibles)
# Vide ou absent : mock.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# Optionnels : surchargent presets/providers.yaml
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- Contrôle qualité (étape 4) ----------------------------------------------
# Seuils, poids et règles : presets/qc.yaml. Trois couches :
# 1. détecteurs visages/mains/texte et 2. cohérence des personnages (CCIP) :
#    dghs (extra optionnel : pip install -e "engine[qc]") | mock
QC_DETECTORS_PROVIDER=dghs
QC_IDENTITY_PROVIDER=dghs
# 3. vision « la case colle-t-elle à sa description ? » :
#    ollama (Qwen3-VL 4B, voir presets/providers.yaml ; `ollama pull qwen3-vl:4b`) | mock
#    (DeepSeek n'accepte pas d'images)
VISION_PROVIDER=ollama

# --- Savoir-faire (RAG local) ------------------------------------------------
# Embeddings des fiches de méthode : ollama | mock (vecteurs factices, défaut).
# Modèle : presets/providers.yaml (ollama.embedding_model). Suggestion : bge-m3, multilingue,
# bon en français — à valider avant tout téléchargement, puis `ollama pull bge-m3`.
EMBEDDING_PROVIDER=ollama

# --- ComfyUI ---------------------------------------------------------------------
# http (vrai ComfyUI local) | mock (images factices, aucun GPU ; défaut sans .env)
# Passer au vrai ComfyUI de la GX10 :
#   1. lancer ComfyUI (python main.py --listen 127.0.0.1 --port 8188) ;
#   2. COMFYUI_PROVIDER=http et COMFYUI_URL ci-dessous, puis relancer le moteur ;
#   3. tableau de bord → « Tester la connexion » (nœuds, modèles, LoRA des presets), puis
#      « Générer une case d'essai ». Le palier Qualité / Rapide se choisit par série
#      (workflow de la série) : voir presets/README.md.
COMFYUI_PROVIDER=http
COMFYUI_URL=http://127.0.0.1:8188
# Délai d'une requête HTTP (s) ; la durée max d'une génération est timeout_s du preset.
# COMFYUI_TIMEOUT_S=5

# --- Stockage ------------------------------------------------------------------
# MANGAKA_DATA_DIR=./data
# MAX_UPLOAD_MB=20
